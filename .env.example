# 微信小程序 AppID/AppSecret
WECHAT_APPID=your_appid
WECHAT_APPSECRET=your_appsecret

# ============ 微信支付 APIv3 配置 ============
WECHAT_PAY_MCHID=your_mchid
WECHAT_PAY_API_V3_KEY=your_32_char_api_v3_key
WECHAT_PAY_SERIAL_NO=your_cert_serial_no
WECHAT_PAY_PRIVATE_KEY_PATH=/path/to/apiclient_key.pem
WECHAT_PAY_PUBLIC_KEY_PATH=/path/to/wechatpay_public.pem
WECHAT_PAY_NOTIFY_URL=https://your-service.tcloudbase.com/api/pay/notify

# 客服消息配置
WECHAT_CS_TOKEN=your_cs_token
CS_DEFAULT_LINK=https://www.baidu.com

# 数据库（云托管 MySQL，云托管自动注入）
# MYSQL_USERNAME=root
# MYSQL_PASSWORD=your_password
# MYSQL_ADDRESS=host:port

# 服务端口
PORT=3000
