# 微信小程序 AppID/AppSecret
WECHAT_APPID=your_appid
WECHAT_APPSECRET=your_appsecret

# JWT 密钥
JWT_SECRET=chuangjingxr_jwt_secret_2026

# ============ 微信支付 APIv3 配置 ============
WECHAT_PAY_MCHID=your_mchid
WECHAT_PAY_API_V3_KEY=your_32_char_api_v3_key
WECHAT_PAY_SERIAL_NO=your_cert_serial_no
# 方式1（云托管推荐）：直接设密钥内容，优先级高于文件路径
# 注意：环境变量中换行符用 \n 表示，代码自动替换为真实换行
# WECHAT_PAY_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nXXXX\n-----END PRIVATE KEY-----
# WECHAT_PAY_PUBLIC_KEY=-----BEGIN CERTIFICATE-----\nXXXX\n-----END CERTIFICATE-----
# 方式2（本地开发）：设文件路径（仅当对应环境变量为空时生效）
WECHAT_PAY_PRIVATE_KEY_PATH=./certs/apiclient_key.pem
WECHAT_PAY_PUBLIC_KEY_PATH=./certs/wechatpay_public.pem
WECHAT_PAY_NOTIFY_URL= # 可选：不开公网则留空，以主动查单代替回调

# 客服消息配置
WECHAT_CS_TOKEN=your_cs_token
CS_DEFAULT_LINK=https://www.baidu.com

# 数据库（云托管 MySQL，云托管自动注入）
# MYSQL_USERNAME=root
# MYSQL_PASSWORD=your_password
# MYSQL_ADDRESS=host:port

# 服务端口
PORT=3000
